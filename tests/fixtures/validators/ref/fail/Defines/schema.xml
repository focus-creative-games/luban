  <bean name="Reward"><var name="id" type="int"/><var name="item_id" type="int#ref=TbItem"/></bean>
  <table name="TbItem" value="Item" input="*@item.json"/>
  <table name="TbReward" value="Reward" input="*@reward.json"/>
